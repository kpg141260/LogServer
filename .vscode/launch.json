{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Debug LogServer",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/log_server.py",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/.venv/bin/python",
            "pythonArgs": ["-Xfrozen_modules=off"],
            "windows": {
                "python": "${workspaceFolder}/.venv/Scripts/python.exe"
            },
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}
